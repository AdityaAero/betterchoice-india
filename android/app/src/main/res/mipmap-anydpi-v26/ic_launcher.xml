<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: the launcher masks these two layers to whatever shape the device uses (circle,
  squircle, rounded square). The background is the logo tile's own navy, so the foreground's tile
  edge disappears into it and only the artwork reads, safely inside the 66dp safe zone.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>

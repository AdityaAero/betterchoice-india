<resources>
    <!--
      Dark theme, picked automatically when the phone is in dark mode. The colour values themselves
      come from values-night/colors.xml, so the two stay in step; only the parent and the light/dark
      system-bar flags differ from the light theme.
    -->
    <style name="Theme.BetterChoice" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/bc_green</item>
        <item name="android:textColorPrimary">@color/bc_ink</item>
        <item name="android:textColorSecondary">@color/bc_muted</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/bc_paper</item>
        <item name="android:navigationBarColor">@color/bc_paper</item>
        <item name="android:windowBackground">@color/bc_paper</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/bc_splash_background</item>
    </style>
</resources>
